{
    "description": "Long-press zxcv for commanded versions",
    "manipulators": [

  {
      "type": "basic",
      "from": { "key_code": "z"},
      "parameters": {
	  "basic.to_if_alone_timeout_milliseconds": 200,
	  "basic.to_if_held_down_threshold_milliseconds": 200
      },
             "to_delayed_action": {
                "to_if_canceled": [
                    {
                        "key_code": "z",
                        "modifiers": []
			,"halt": true
                    }
                ]
            },
      "to_if_alone":  { "key_code": "z" ,"halt": true },
      "to_if_held_down": [
	  { "key_code": "z", "modifiers":  ["left_command"], "halt": true  }
      ]
  },


