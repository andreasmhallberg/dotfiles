{
    "description": "j+k = backspace, delete word if held",
    "manipulators": [

{
    "type": "basic",
    "from": {
        "simultaneous": [
            {
                "key_code": "j"
            },
            {
                "key_code": "k"
            }
        ],
        "modifiers": {
            "optional": ["any"]
        }
    },

    "parameters": {
	"basic.to_delayed_action_delay_milliseconds": 200,
	"basic.to_if_held_down_threshold_milliseconds":200 
  },
            "to_delayed_action": {
                "to_if_canceled": [
                    {
                        "key_code": "f",
                        "halt": true
                    }
                ]
            },
            "to_if_alone": [
                {
                    "key_code": "delete_or_backspace",
                    "halt": true
                }
            ],
            "to_if_held_down": [
                {
                    "key_code": "delete_or_backspace" ,
		    "modifiers": "left_alt",
		    "halt": true
                }
            ],
            "type": "basic"
        }

    ]
}
